<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location: needed to set a task's reminder location and to monitor geofences -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Notifications (required at runtime on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact time-based alarms -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Re-arm alarms/geofences after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keep the CPU awake long enough to show a reminder notification -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".TikApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tik">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Tik">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires the notification when a time-based reminder is due -->
        <receiver
            android:name=".reminder.AlarmReceiver"
            android:exported="false" />

        <!-- Fires the notification when a geofence transition (enter/exit) happens -->
        <receiver
            android:name=".reminder.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- "Mark as done" action button on a reminder notification -->
        <receiver
            android:name=".reminder.MarkDoneReceiver"
            android:exported="false" />

        <!-- "Snooze" action button on a reminder notification -->
        <receiver
            android:name=".reminder.SnoozeReceiver"
            android:exported="false" />

        <!-- Fires once the snooze delay elapses, re-showing the reminder -->
        <receiver
            android:name=".reminder.SnoozeAlarmReceiver"
            android:exported="false" />

        <!-- Re-schedules alarms and geofences after the device reboots -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Home screen widget -->
        <receiver
            android:name=".widget.TikWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tik_widget_info" />
        </receiver>

    </application>

</manifest>
