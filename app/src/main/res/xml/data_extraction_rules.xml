<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup. Room runs SQLite in WAL mode, so the newest writes sit in
    tik.db-wal until they're checkpointed into tik.db. Backing up tik.db alone could
    restore a database missing recent changes — so all three files go together.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="tik.db" />
        <include domain="database" path="tik.db-wal" />
        <include domain="database" path="tik.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tik.db" />
        <include domain="database" path="tik.db-wal" />
        <include domain="database" path="tik.db-shm" />
    </device-transfer>
</data-extraction-rules>
